{
  "name": "ai-net-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:imports": "node scripts/check-imports.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "lint": "eslint src --ext .ts,.tsx --quiet",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "12.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "framer-motion": "^12.40.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lodash": "4.17.21",
    "lucide-react": "0.469.0",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.2",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "6.30.4",
    "react-syntax-highlighter": "^16.1.1",
    "reactflow": "11.11.4",
    "recharts": "2.13.3",
    "remark-gfm": "^4.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.45.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.19.21",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/coverage-v8": "^2.1.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.5.0",
    "eslint": "8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "25.0.1",
    "msw": "^2.3.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.15",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "ws": "^8.17.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
